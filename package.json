{
  "name": "authkit-ts",
  "version": "0.1.0",
  "description": "A small TypeScript auth gateway that keeps AI provider keys off the client. Built for Pinpoint Pro.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "start": "node dist/src/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2"
  }
}
